{
  "name": "mcp-code-graph",
  "version": "1.0.0",
  "description": "MCP server exposing real-time codebase dependency graph as queryable tools for GitHub Copilot agents",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-code-graph": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "code-graph",
    "dependency-graph",
    "github-copilot",
    "tree-sitter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "glob": "^11.0.1",
    "minimatch": "^10.2.4",
    "tree-sitter": "^0.22.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
