{
  "name": "mcp-code-graph",
  "version": "1.0.0",
  "description": "CodeGraph v2 MCP proxy and persistent semantic indexer for Copilot/Codex agents",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "mcp-code-graph": "dist/cli.js",
    "codegraph": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.mkdirSync('dist/v2/storage',{recursive:true});fs.copyFileSync('src/v2/storage/postgres-schema.sql','dist/v2/storage/postgres-schema.sql')\"",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "code-graph",
    "dependency-graph",
    "github-copilot",
    "tree-sitter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^4.0.3",
    "glob": "^11.0.1",
    "minimatch": "^10.2.4",
    "pg": "^8.21.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
