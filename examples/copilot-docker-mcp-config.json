{
  "mcpServers": {
    "codegraph-hadoop": {
      "type": "local",
      "command": "docker",
      "args": [
        "--context",
        "desktop-linux",
        "run",
        "--rm",
        "-i",
        "-v",
        "D:/Personal/Projects/hadoop:/workspace",
        "-e",
        "CODEGRAPH_WORKSPACE_KEY=D:/Personal/Projects/hadoop",
        "mcp-code-graph:latest",
        "mcp",
        "--root",
        "/workspace",
        "--no-prewarm"
      ],
      "env": {},
      "tools": ["*"]
    }
  }
}
