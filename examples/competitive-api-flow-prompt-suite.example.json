{
  "name": "competitive-codegraph-api-flow-prompt-suite",
  "repoRoot": ".",
  "rootProfile": {
    "name": "codegraph-api-flow-competitive",
    "requiredFiles": [
      "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
      "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
      "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
      "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java",
      "tests/fixtures/ts-project/src/order-controller.ts",
      "tests/fixtures/ts-project/src/order-service.behavior.test.ts"
    ],
    "requiredMethods": [
      "create",
      "createOrder",
      "checkAvailability",
      "charge",
      "getOrder",
      "listOrders"
    ]
  },
  "tasks": [
    {
      "id": "natural-post-orders-trace",
      "type": "api-flow",
      "prompt": "trace api \"POST /orders\" please. Explain the request flow from endpoint handler to service calls and side effects. Return compact JSON with keys task,endpoint,keyFiles,methods,flow,sideEffects,tests,confidence.",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java"
      ],
      "expectedMethods": [
        "create",
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "POST",
        "/orders",
        "inventory",
        "payment"
      ],
      "requiredAnswerFields": [
        "task",
        "endpoint",
        "keyFiles",
        "methods",
        "flow",
        "sideEffects"
      ],
      "requireJson": true
    },
    {
      "id": "natural-get-order-trace",
      "type": "api-flow",
      "prompt": "trace api \"GET /orders/{id}\" please. Explain which handler and service method answer it, and note what it does not call. Return compact JSON with keys task,endpoint,keyFiles,methods,flow,notCalled,tests,confidence.",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java"
      ],
      "expectedMethods": [
        "get",
        "getOrder"
      ],
      "expectedTerms": [
        "GET",
        "/orders/{id}",
        "PaymentService",
        "InventoryService"
      ],
      "requiredAnswerFields": [
        "task",
        "endpoint",
        "keyFiles",
        "methods",
        "flow",
        "notCalled"
      ],
      "requireJson": true
    },
    {
      "id": "api-change-planning",
      "type": "implement",
      "prompt": "We need to add a fraud check before charging in POST /orders. Plan the smallest safe change and name affected endpoint files, service files, tests, invariants, and validation commands. Return compact JSON with keys task,endpoint,keyFiles,methods,plan,invariants,tests,validation,confidence.",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java"
      ],
      "expectedMethods": [
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "fraud",
        "POST /orders",
        "before charging"
      ],
      "requiredAnswerFields": [
        "task",
        "endpoint",
        "keyFiles",
        "methods",
        "plan",
        "tests",
        "validation"
      ],
      "requireJson": true
    },
    {
      "id": "api-review-diff",
      "type": "code-review",
      "prompt": "Review this API patch for endpoint behavior regressions and missing tests. Return compact JSON with keys status,topFindings,impactedEndpoint,impactedFlow,tests,confidence.\n\ndiff --git a/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java b/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java\n--- a/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java\n+++ b/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java\n@@\n-        inventoryService.checkAvailability(request.getItems());\n-        paymentService.charge(request.getPaymentInfo());\n+        paymentService.charge(request.getPaymentInfo());\n+        inventoryService.checkAvailability(request.getItems());",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java"
      ],
      "expectedMethods": [
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "POST /orders",
        "regression",
        "test"
      ],
      "requiredAnswerFields": [
        "status",
        "topFindings",
        "impactedEndpoint",
        "impactedFlow",
        "tests"
      ],
      "requireJson": true
    },
    {
      "id": "api-test-discovery",
      "type": "test",
      "prompt": "Find the tests that should prove order creation behavior across controller/service code, especially payment and inventory side effects. Return compact JSON with keys task,keyFiles,testFiles,testCases,coveredBehaviors,gaps,confidence.",
      "expectedFiles": [
        "tests/fixtures/ts-project/src/order-service.behavior.test.ts",
        "tests/fixtures/ts-project/src/order-service.ts",
        "tests/fixtures/ts-project/src/order-controller.ts"
      ],
      "expectedMethods": [
        "create",
        "createOrder"
      ],
      "expectedTerms": [
        "PaymentService",
        "InventoryService",
        "side effects"
      ],
      "requiredAnswerFields": [
        "task",
        "keyFiles",
        "testFiles",
        "testCases",
        "coveredBehaviors"
      ],
      "requireJson": true
    }
  ]
}
