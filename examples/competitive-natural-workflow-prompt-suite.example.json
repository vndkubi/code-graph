{
  "name": "competitive-natural-workflow-prompt-suite",
  "repoRoot": ".",
  "rootProfile": {
    "name": "natural-workflow-order-fixtures",
    "requiredFiles": [
      "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
      "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
      "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
      "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java",
      "tests/fixtures/ts-project/src/order-service.behavior.test.ts"
    ],
    "requiredMethods": [
      "create",
      "createOrder",
      "checkAvailability",
      "charge",
      "getOrder"
    ]
  },
  "tasks": [
    {
      "id": "natural-investigation-order-side-effects",
      "type": "investigation",
      "prompt": "Something feels off in order creation: charging may happen before inventory is verified. Investigate the flow and tell me the files, methods, current ordering, risk, and tests that should catch it. Return compact JSON with keys task,keyFiles,methods,currentFlow,risks,tests,confidence.",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java"
      ],
      "expectedMethods": [
        "create",
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "inventory",
        "payment",
        "before inventory"
      ],
      "requiredAnswerFields": [
        "task",
        "keyFiles",
        "methods",
        "currentFlow",
        "risks",
        "tests"
      ],
      "requireJson": true
    },
    {
      "id": "natural-trace-post-orders",
      "type": "api-flow",
      "prompt": "trace api \"POST /orders\" please. Explain the request path from handler to service calls, side effects, and the tests I should trust. Return compact JSON with keys task,endpoint,keyFiles,methods,flow,sideEffects,tests,confidence.",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java"
      ],
      "expectedMethods": [
        "create",
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "POST",
        "/orders",
        "inventory",
        "payment"
      ],
      "requiredAnswerFields": [
        "task",
        "endpoint",
        "keyFiles",
        "methods",
        "flow",
        "sideEffects",
        "tests"
      ],
      "requireJson": true
    },
    {
      "id": "natural-implement-fraud-check-ut",
      "type": "implement",
      "prompt": "I need to add a fraud check before charging when an order is created, and cover it with unit tests. Give me the smallest implementation and unit-test changes, affected files and methods, invariants, and validation commands. Return compact JSON with keys task,keyFiles,methods,implementation,unitTests,invariants,validation,confidence.",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java",
        "tests/fixtures/ts-project/src/order-service.behavior.test.ts"
      ],
      "expectedMethods": [
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "fraud",
        "before charging",
        "unit test"
      ],
      "requiredAnswerFields": [
        "task",
        "keyFiles",
        "methods",
        "implementation",
        "unitTests",
        "invariants",
        "validation"
      ],
      "requireJson": true
    },
    {
      "id": "natural-code-review-order-regression",
      "type": "code-review",
      "prompt": "Please code review this order creation patch for behavior regressions and missing tests. Return compact JSON with keys status,topFindings,impactedFlow,tests,confidence.\n\ndiff --git a/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java b/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java\n--- a/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java\n+++ b/tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java\n@@\n-        inventoryService.checkAvailability(request.getItems());\n-        paymentService.charge(request.getPaymentInfo());\n+        paymentService.charge(request.getPaymentInfo());\n+        inventoryService.checkAvailability(request.getItems());",
      "expectedFiles": [
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderService.java",
        "tests/fixtures/java-project/src/main/java/com/example/order/OrderController.java",
        "tests/fixtures/java-project/src/main/java/com/example/inventory/InventoryService.java",
        "tests/fixtures/java-project/src/main/java/com/example/payment/PaymentService.java"
      ],
      "expectedMethods": [
        "createOrder",
        "checkAvailability",
        "charge"
      ],
      "expectedTerms": [
        "regression",
        "missing test",
        "before inventory"
      ],
      "requiredAnswerFields": [
        "status",
        "topFindings",
        "impactedFlow",
        "tests"
      ],
      "requireJson": true
    }
  ]
}
