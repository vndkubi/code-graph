# Example: C:/Users/<your-user>/.codex/config.toml
#
# Use one MCP server per project/branch when using Docker from Codex CLI.
# All entries can share the same Docker image. Keep CODEGRAPH_WORKSPACE_KEY
# unique per host project path so /workspace does not collapse different
# repositories into one workspace identity.

[mcp_servers.code_graph_doughnut]
command = "docker"
args = [
  "run",
  "--rm",
  "-i",
  "-v",
  "D:/Personal/Projects/doughnut:/workspace",
  "-e",
  "CODEGRAPH_WORKSPACE_KEY=D:/Personal/Projects/doughnut",
  "mcp-code-graph:latest",
  "mcp",
  "--root",
  "/workspace",
  "--auto-refresh"
]

[mcp_servers.code_graph_mall]
command = "docker"
args = [
  "run",
  "--rm",
  "-i",
  "-v",
  "D:/Personal/Projects/mall:/workspace",
  "-e",
  "CODEGRAPH_WORKSPACE_KEY=D:/Personal/Projects/mall",
  "mcp-code-graph:latest",
  "mcp",
  "--root",
  "/workspace",
  "--auto-refresh"
]

[mcp_servers.code_graph_jakartaee8]
command = "docker"
args = [
  "run",
  "--rm",
  "-i",
  "-v",
  "D:/Personal/Projects/samples/jarkataEE8:/workspace",
  "-e",
  "CODEGRAPH_WORKSPACE_KEY=D:/Personal/Projects/samples/jarkataEE8",
  "mcp-code-graph:latest",
